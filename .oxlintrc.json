{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "ignorePatterns": [
    "node_modules/**",
    "memory/**",
    ".git/**",
    ".agents/**",
    ".codex/**",
    ".aws/**"
  ]
}
