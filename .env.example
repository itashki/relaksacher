# Скопируй этот файл в .env и заполни настройки выбранных платформ.
# Не публикуй .env: токены и API-ключи должны оставаться секретными.
# После изменений перезапусти бота. Все таймауты и интервалы — в миллисекундах.

# Платформы: discord, telegram или discord,telegram.
BOT_ADAPTERS=discord

# Объединять серии сообщений одного автора после паузы 1200 мс; 0 отключает. Максимум 5000.
MESSAGE_BATCH_WINDOW_MS=1200

# Discord: обязательны только при включённом адаптере discord.
# Discord Developer Portal → приложение → Bot → Token.
BOT_TOKEN=

# Telegram: токен от @BotFather; обязателен только для адаптера telegram.
TELEGRAM_BOT_TOKEN=
# Интервал редактирования ответа (минимум 1000); первый и финальный апдейты сразу.
TELEGRAM_UPDATE_INTERVAL_MS=5000
TELEGRAM_TIMEOUT_MS=60000

# llama-server: GGUF-файлы в /var/lib/llama-models (скачивание — в README).
# Одновременно работает один процесс модели; llama-server запускает сам бот.
LLAMA_MODEL=/var/lib/llama-models/Ternary-Bonsai-2.5-27B-Uncensored-PTQ1_0.gguf
# Проектор для изображений и видео; без него изображения не принимаются.
LLAMA_MMPROJ=/var/lib/llama-models/Ternary-Bonsai-2.5-27B-mmproj-Q8_0.gguf
# Необязательная отдельная модель для изображений и видео.
# LLAMA_VISION_MODEL=/var/lib/llama-models/Qwen3VL-4B-Instruct-Q4_K_M.gguf
# Необязательная малая модель для вспомогательных решений (по умолчанию LLAMA_MODEL).
# LLAMA_SUPERVISOR_MODEL=/var/lib/llama-models/Qwen3-0.6B-Q8_0.gguf
# Контекст в токенах; он же задаёт -c у llama-server (калибровка — в README).
OLLAMA_NUM_CTX=8192
# Таймаут генерации без учёта ожидания в очереди.
OLLAMA_TIMEOUT=300000

# Необязательный ключ облачного веб-поиска Ollama (не связан с локальной моделью).
# Без ключа или при ошибке провайдера используется DuckDuckGo.
OLLAMA_API_KEY=

# Таймаут вспомогательных решений: маршрутизация размышлений, факты, спонтанные ответы.
OLLAMA_SUPERVISOR_TIMEOUT_MS=30000

# Автоматическое запоминание в группах; false отключает.
AUTO_MEMORY=true
# Пауза после сохранения: 120000 = 2 минуты. Минимум 1000.
AUTO_MEMORY_COOLDOWN_MS=120000
# Интервал проверок: 60000 = 1 минута. Минимум 1000.
AUTO_MEMORY_CHECK_INTERVAL_MS=60000

# Спонтанные ответы без обращения к боту; false отключает.
SPONTANEOUS_REPLIES=true
# Доля подходящих сообщений для оценки (0–1); 0.2 = 20%, ответ не гарантирован.
SPONTANEOUS_CHANCE=0.2
# Пауза между спонтанными ответами в чате/теме; минимум 30000.
SPONTANEOUS_COOLDOWN_MS=300000

# Локальные файлы относительно корня проекта. JSON5-файлы нужно создать;
# каждый содержит массив строк, для начала можно использовать пустой массив [].
FACTS_FILE=facts.json5
PERSONALITY_FILE=personality.json5
# Каталог долговременной памяти создаётся автоматически.
MEMORY_DIR=memory

# Поиск GIF в KLIPY (https://partner.klipy.com): укажи свой API-ключ.
# Пустое значение отключает инструменты GIF; поиск обычных картинок работает отдельно.
KLIPY_API_KEY=

# Русская речь: GigaAM-v3 e2e_rnnt, пунктуация, CUDA при доступности.
TRANSCRIPTION_BACKEND=gigaam
GIGAAM_URL=http://127.0.0.1:8082/inference
GIGAAM_AUTO_START=true
GIGAAM_DEVICE=auto
# Nix задаёт Python и каталог весов; без Nix установите GigaAM самостоятельно.
# GIGAAM_PYTHON=python3
# GIGAAM_MODEL_DIR=models/gigaam

# Видеосообщения (кружки) Telegram: reply (по умолчанию, описание ответом в чат),
# silent (только сохранять) или off.
# VIDEO_NOTE_DESCRIPTION=reply
# Необязательный прежний backend: TRANSCRIPTION_BACKEND=whisper.
WHISPER_URL=http://127.0.0.1:8080/inference
WHISPER_TIMEOUT_MS=300000

# Автозапуск локального Whisper вместе с ботом; false — внешний процесс.
WHISPER_AUTO_START=true
# Nix задаёт пути моделей автоматически. Без Nix скачайте модели в models/.
# WHISPER_MODEL=models/ggml-small.bin


SILERO_PYTHON=python3
# SILERO_MODEL=models/silero-v5_6_ru.pt
# SILERO_MODEL_EN=models/silero-v3_en.pt
SILERO_SPEAKER=random
SILERO_SPEAKER_EN=random

# Журнал входящих запросов без ответов модели и текстов расшифровки войсов.
# Относительный путь считается от корня проекта.
REQUEST_LOG_FILE=logs/requests.jsonl
