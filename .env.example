# Скопируй этот файл в .env и заполни настройки выбранных платформ.
# Не публикуй .env: токены и API-ключи должны оставаться секретными.
# После изменений перезапусти бота. Все таймауты и интервалы — в миллисекундах.

# Платформы: discord, telegram или discord,telegram.
BOT_ADAPTERS=discord

# Discord: обязательны только при включённом адаптере discord.
# Discord Developer Portal → приложение → Bot → Token.
BOT_TOKEN=
# General Information → Application ID и Public Key.
APPLICANT_ID=
PUBLIC_KEY=

# Telegram: токен от @BotFather; обязателен только для адаптера telegram.
TELEGRAM_BOT_TOKEN=
# Интервал редактирования ответа (минимум 1000); первый и финальный апдейты сразу.
TELEGRAM_UPDATE_INTERVAL_MS=5000
TELEGRAM_TIMEOUT_MS=60000

# Ollama: сервер и установленная основная модель для всех ответов.
# Имя модели ниже — пример; укажи модель, установленную на своём сервере.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Контекст в токенах: большее окно требует больше памяти.
OLLAMA_NUM_CTX=16384
# Таймаут генерации без учёта ожидания в очереди.
OLLAMA_TIMEOUT=300000

# Необязательный ключ облачного веб-поиска Ollama.
# Без ключа или при ошибке провайдера используется DuckDuckGo.
OLLAMA_API_KEY=

# Небольшая установленная модель для маршрутизации размышлений,
# извлечения полезных фактов и оценки спонтанных ответов.
OLLAMA_SUPERVISOR_MODEL=qwen3:0.6b
OLLAMA_SUPERVISOR_TIMEOUT_MS=30000

# Автоматическое запоминание в группах; false отключает.
AUTO_MEMORY=true
# Пауза после сохранения: 120000 = 2 минуты. Минимум 1000.
AUTO_MEMORY_COOLDOWN_MS=120000
# Интервал проверок: 60000 = 1 минута. Минимум 1000.
AUTO_MEMORY_CHECK_INTERVAL_MS=60000

# Спонтанные ответы без обращения к боту; false отключает.
SPONTANEOUS_REPLIES=true
# Доля подходящих сообщений для оценки (0–1); 0.05 = 5%, ответ не гарантирован.
SPONTANEOUS_CHANCE=0.05
# Пауза между спонтанными ответами в чате/теме; минимум 30000.
SPONTANEOUS_COOLDOWN_MS=300000

# Локальные файлы относительно корня проекта. JSON5-файлы нужно создать;
# каждый содержит массив строк, для начала можно использовать пустой массив [].
FACTS_FILE=facts.json5
PERSONALITY_FILE=personality.json5
# Каталог долговременной памяти создаётся автоматически.
MEMORY_DIR=memory

# Поиск GIF в KLIPY (https://partner.klipy.com): укажи свой API-ключ.
# Пустое значение отключает инструменты GIF; поиск обычных картинок работает отдельно.
KLIPY_API_KEY=
